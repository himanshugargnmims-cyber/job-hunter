# ==============================================================================
# Job Hunter Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline & Automation Settings
# ------------------------------------------------------------------------------
# Minimum fit score threshold (0-100) for a job to qualify for application
MIN_FIT_SCORE=70
MAX_RESULTS_PER_COMPANY=5
LOG_LEVEL=INFO

# Browser Automation: "true" for headless background execution, "false" for visible browser window
HEADLESS=false

# ------------------------------------------------------------------------------
# 2. Compensation Floor (Roles below these thresholds are automatically excluded)
# ------------------------------------------------------------------------------
MIN_SALARY_FLOOR_LPA=30.0
MIN_SALARY_FLOOR_USD=60000.0
MIN_SALARY_FLOOR_EUR=55000.0

# ------------------------------------------------------------------------------
# 3. AI Screening Question Answering (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key to dynamically draft personalized 2-3 sentence answers
# to open-ended ATS screening questions based on your profile notes.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Automated Greenhouse OTP / Security Code Resolution via Gmail (Optional)
# ------------------------------------------------------------------------------
# If Greenhouse asks for an email verification security code, Job Hunter can
# fetch the code via IMAP from Gmail automatically.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Cloud Spreadsheet Sync via Google Sheets (Optional)
# ------------------------------------------------------------------------------
# Path to Google Service Account JSON key
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_SHEET_NAME=Job Application Tracker
# GOOGLE_SHEET_ID=your_google_sheet_id_here

# ------------------------------------------------------------------------------
# 6. Webhook Notifications (Optional)
# ------------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
